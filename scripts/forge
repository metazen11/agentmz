#!/usr/bin/env bash
# Forge CLI wrapper - sets up env and passes all args
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Load environment variables
if [[ -f "$REPO_ROOT/.env" ]]; then
    set -a
    source "$REPO_ROOT/.env"
    set +a
fi

# Activate venv
source "$REPO_ROOT/venv/bin/activate"

# Set PYTHONPATH
export PYTHONPATH="$REPO_ROOT:$PYTHONPATH"

# Ensure ~/.local/bin is in PATH (for aider, etc.)
export PATH="$HOME/.local/bin:$PATH"

# Default workspace to cwd if not specified
if [[ ! "$*" =~ (-w[[:space:]]|--workspace[[:space:]]|--workspace=) ]]; then
    exec python -m forge main --workspace "$(pwd)" "$@"
else
    exec python -m forge main "$@"
fi
